+uint8_t cdi_native_text_byte(uint32_t address, uint8_t original) {
+    static CdiTextMod mod;
+    if (!mod.loaded) {
+        if (!cdi_text_mod_load(&mod, getenv("CDI_TEXT_MOD_PATH")))
+            fprintf(stderr,"[text-mod] invalid pilot configuration; original text retained\n");
+        else if (mod.enabled) fprintf(stderr,"[text-mod] Adventure menu pilot enabled\n");
+    }
+    if (!mod.enabled) return original;
+    for (uint32_t i=0;i<binding_count;i++) {
+        const Binding *b=&bindings[i];
+        if (!b->valid || b->size!=125566u || strcmp(b->module->name,"cdi_zelda") ||
+            g_cpu.PC<b->base) continue;
+        uint32_t offset=g_cpu.PC-b->base;
+        /* Verified glyph-draw and text-width reads for the bound revision.
+         * File/save comparisons and OS-9 copies do not pass this gate. */
+        if (offset!=0x75eau && offset!=0x7656u) continue;
+        uint64_t before=mod.hits;
+        uint8_t result=original;
+        if (address<CDI_RAM0_SIZE)
+            result=cdi_text_mod_byte(&mod,g_ram0,CDI_RAM0_SIZE,address,original);
+        else if (address>=CDI_RAM1_BASE && address-CDI_RAM1_BASE<CDI_RAM1_SIZE)
+            result=cdi_text_mod_byte(&mod,g_ram1,CDI_RAM1_SIZE,address-CDI_RAM1_BASE,original);
+        if (!before && mod.hits) fprintf(stderr,"[text-mod] translated confirmed menu label\n");
+        return result;
+    }
+    return original;
+}
