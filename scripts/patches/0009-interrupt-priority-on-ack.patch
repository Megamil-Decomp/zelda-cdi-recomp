--- a/runner/src/runtime.c
+++ b/runner/src/runtime.c
@@ -561,6 +561,10 @@ void recomp_take_irq(void) {
     if (!onchip && !vec) vec = (uint8_t)(24 + lvl);
     if (!onchip) s_irq_external_vector[lvl] = 0;
     build_exception_frame(vec);
+    /* SCC68070 interrupt acknowledge raises the active IPL and suppresses
