+    /* Replacing a sound can withdraw the queued other buffer. Once the
+     * active buffer drains, CD-RTOS may refill buffer 0 even though the old
+     * sound would have consumed buffer 1 next. PLAY0 must retain that new
+     * selection until a real handoff arrives, while preserving the active
+     * buffer's pointer and duration. A stranded handoff also strands FINISH. */
+    cdic_write(CDI_CDIC_BASE + 0x25A6, 0x0006, 2);
